"""
mdvrp/problem.py
----------------
Core data structures for the Multi-Depot Vehicle Routing Problem.

Classes
-------
Customer  : A single customer node with coordinates and demand.
Depot     : A depot node with coordinates and fleet capacity.
Route     : An ordered sequence of customers served from one depot.
Problem   : Full MDVRP instance (depots + customers + parameters).
"""

from __future__ import annotations
import math
import random
from dataclasses import dataclass, field
from typing import List, Optional
from copy import deepcopy


# ── Primitive nodes ───────────────────────────────────────────────────────────

@dataclass
class Customer:
    """A customer node.

    Parameters
    ----------
    id : int
        Unique zero-based index.
    x, y : float
        Coordinates on a 2-D Euclidean plane.
    demand : int
        Units of goods required (must fit within vehicle capacity).
    """
    id: int
    x: float
    y: float
    demand: int

    def distance_to(self, other: "Customer | Depot") -> float:
        """Euclidean distance to another node."""
        return math.hypot(self.x - other.x, self.y - other.y)


@dataclass
class Depot:
    """A depot node.

    Parameters
    ----------
    id : int
        Unique zero-based index.
    x, y : float
        Coordinates on a 2-D Euclidean plane.
    capacity : int
        Maximum load a single vehicle departing from this depot can carry.
    """
    id: int
    x: float
    y: float
    capacity: int

    def distance_to(self, other: "Customer | Depot") -> float:
        """Euclidean distance to another node."""
        return math.hypot(self.x - other.x, self.y - other.y)


# ── Route ─────────────────────────────────────────────────────────────────────

@dataclass
class Route:
    """An ordered sequence of customers served by one vehicle from one depot.

    Parameters
    ----------
    depot : Depot
        The depot this route starts and ends at.
    customers : list of Customer
        Ordered list of customers visited.
    """
    depot: Depot
    customers: List[Customer] = field(default_factory=list)

    # ── derived properties ────────────────────────────────────────────────────

    @property
    def total_demand(self) -> int:
        """Sum of demands of all customers on the route."""
        return sum(c.demand for c in self.customers)

    @property
    def is_feasible(self) -> bool:
        """True if total demand does not exceed depot vehicle capacity."""
        return self.total_demand <= self.depot.capacity

    @property
    def distance(self) -> float:
        """Total Euclidean distance: depot → c1 → c2 → ... → depot."""
        if not self.customers:
            return 0.0
        nodes = [self.depot] + self.customers + [self.depot]
        return sum(nodes[i].distance_to(nodes[i + 1])
                   for i in range(len(nodes) - 1))

    # ── mutation helpers ──────────────────────────────────────────────────────

    def copy(self) -> "Route":
        """Return a deep copy of this route."""
        return Route(depot=self.depot, customers=list(self.customers))

    def two_opt(self) -> "Route":
        """Apply best-improvement 2-opt to this route (in-place).

        Iterates over all pairs (i, j) and reverses the sub-segment if it
        yields a shorter total distance.  Returns self for chaining.
        """
        improved = True
        while improved:
            improved = False
            n = len(self.customers)
            for i in range(n - 1):
                for j in range(i + 2, n):
                    # cost of reversing segment [i+1 .. j]
                    a, b = self.customers[i], self.customers[i + 1]
                    c, d = self.customers[j], self.customers[(j + 1) % n]
                    before = a.distance_to(b) + c.distance_to(d)
                    after  = a.distance_to(c) + b.distance_to(d)
                    if after < before - 1e-9:
                        self.customers[i + 1:j + 1] = \
                            self.customers[i + 1:j + 1][::-1]
                        improved = True
        return self

    def __repr__(self) -> str:
        ids = [c.id for c in self.customers]
        return (f"Route(depot={self.depot.id}, customers={ids}, "
                f"dist={self.distance:.2f}, load={self.total_demand})")


# ── Problem ───────────────────────────────────────────────────────────────────

class Problem:
    """A complete MDVRP instance.

    Parameters
    ----------
    depots : list of Depot
    customers : list of Customer
    name : str, optional
        Human-readable label for reporting.
    """

    def __init__(
        self,
        depots: List[Depot],
        customers: List[Customer],
        name: str = "MDVRP",
    ) -> None:
        self.depots    = depots
        self.customers = customers
        self.name      = name
        self._dist_matrix: Optional[list] = None

    # ── distance matrix ───────────────────────────────────────────────────────

    def build_distance_matrix(self) -> None:
        """Pre-compute all pairwise distances (nodes = depots + customers).

        Index mapping:
            0 … len(depots)-1           → depots
            len(depots) … len(depots)+len(customers)-1 → customers
        """
        nodes = list(self.depots) + list(self.customers)
        n = len(nodes)
        self._dist_matrix = [
            [nodes[i].distance_to(nodes[j]) for j in range(n)]
            for i in range(n)
        ]

    def dist(self, a_idx: int, b_idx: int) -> float:
        """Return pre-computed distance between node indices a and b."""
        if self._dist_matrix is None:
            self.build_distance_matrix()
        return self._dist_matrix[a_idx][b_idx]

    def depot_idx(self, depot: Depot) -> int:
        """Global node index for a depot."""
        return depot.id

    def customer_idx(self, customer: Customer) -> int:
        """Global node index for a customer."""
        return len(self.depots) + customer.id

    # ── solution evaluation ───────────────────────────────────────────────────

    def total_distance(self, routes: List[Route]) -> float:
        """Sum of distances across all routes."""
        return sum(r.distance for r in routes)

    def is_feasible(self, routes: List[Route]) -> bool:
        """True if every route is feasible and every customer is served exactly once."""
        served = []
        for r in routes:
            if not r.is_feasible:
                return False
            served.extend(c.id for c in r.customers)
        return sorted(served) == list(range(len(self.customers)))

    # ── factory methods ───────────────────────────────────────────────────────

    @classmethod
    def generate_random(
        cls,
        n_customers: int = 20,
        n_depots: int = 2,
        capacity: int = 50,
        grid_size: float = 100.0,
        demand_range: tuple = (5, 20),
        seed: Optional[int] = None,
        name: str = "Random",
    ) -> "Problem":
        """Generate a random MDVRP instance.

        Parameters
        ----------
        n_customers : int
            Number of customer nodes.
        n_depots : int
            Number of depot nodes.
        capacity : int
            Vehicle capacity (same for all depots).
        grid_size : float
            Coordinates are drawn uniformly from [0, grid_size].
        demand_range : (int, int)
            Inclusive range for random customer demands.
        seed : int or None
            Random seed for reproducibility.
        name : str
            Instance label.
        """
        rng = random.Random(seed)
        depots = [
            Depot(id=i,
                  x=rng.uniform(grid_size * 0.2, grid_size * 0.8),
                  y=rng.uniform(grid_size * 0.2, grid_size * 0.8),
                  capacity=capacity)
            for i in range(n_depots)
        ]
        customers = [
            Customer(id=i,
                     x=rng.uniform(0, grid_size),
                     y=rng.uniform(0, grid_size),
                     demand=rng.randint(*demand_range))
            for i in range(n_customers)
        ]
        p = cls(depots=depots, customers=customers, name=name)
        p.build_distance_matrix()
        return p

    # ── dunder ────────────────────────────────────────────────────────────────

    def __repr__(self) -> str:
        return (f"Problem(name={self.name!r}, "
                f"depots={len(self.depots)}, "
                f"customers={len(self.customers)})")
